{
  "uncovered": "block",
  "ignore": [
    "**/*.md",
    "dist/**",
    "screenshots/**",
    ".gitignore"
  ],
  "rules": [
    {
      "match": [
        "vite.config.js",
        "vite-plugin-multi-replace.js",
        "scripts/build-bs5.mjs",
        "scripts/build-bs3.mjs",
        "scripts/build-commonui.mjs",
        "scripts/locks/*.json",
        "package.json",
        "package-lock.json",
        "playwright.config.js",
        "tests/e2e/**",
        "app/themes/*/assets/banner.html"
      ],
      "run": "npm run build && npm run test:e2e"
    },
    {
      "match": [
        "app/js/init.js",
        ".gitmodules",
        ".andon/checks.json"
      ],
      "run": "npm run build && grep -q 'fathom' dist/js/init.js && grep -q 'fathom.trackEvent' dist/js/application.js"
    }
  ]
}
